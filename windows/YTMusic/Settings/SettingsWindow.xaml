<Window x:Class="YTMusic.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        Foreground="White"
        Icon="/Assets/AppIcon.ico">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B3B3B3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,12,24,24" Width="360">
        <TextBlock Text="APPEARANCE" Style="{StaticResource Heading}" />
        <DockPanel>
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemePicker" Width="180" HorizontalAlignment="Right" SelectionChanged="OnThemeChanged">
                <ComboBoxItem Content="YouTube Music" Tag="YouTubeMusic" />
                <ComboBoxItem Content="Spotify-style" Tag="SpotifyStyle" />
            </ComboBox>
        </DockPanel>

        <TextBlock Text="PLAYBACK" Style="{StaticResource Heading}" />
        <CheckBox x:Name="KeepPlaying" Content="Keep playing when the window is closed" Click="OnOptionChanged" />
        <CheckBox x:Name="Notify" Content="Notify when the track changes" Click="OnOptionChanged" />
    </StackPanel>
</Window>
